{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#8.1.0"],
  schedule: ["every weekend"],
  ignorePaths: ["archive/**"],
  customManagers: [
    {
      // The preset's annotation manager expects `key: value` or `KEY=value`;
      // HCL is `name = "value"`.
      customType: "regex",
      description: "Annotated Terraform variable defaults",
      managerFilePatterns: ["/^terraform/.+\\.tf$/"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*default\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
    },
  ],
  mise: {
    managerFilePatterns: ["/^\\.mise/conf\\.d/[^/]+\\.toml$/"],
  },
  packageRules: [
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
      minimumReleaseAge: "3 days",
      overrideDatasource: "github-releases",
    },
    {
      // The flux-operator CLI in .mise/config.toml (a mise tool, so a GitHub
      // datasource) must equal the operator chart tag: scripts/validate-apps.sh
      // fails on a difference. Keep the two in one PR.
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker", "github-releases", "github-tags"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      // The same delay as the "Mise Tools Group" rule above, which would
      // otherwise hold only the CLI back: the charts and the CLI must be
      // proposed together, or the chart PR fails validate-apps.sh until the
      // CLI update ripens.
      minimumReleaseAge: "3 days",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // home-operations also publishes upstream Sonarr v5 pre-releases as 5.x
      // tags. Stay on v4 until v5 is stable. (Docker versioning has no range
      // support, so Renovate evaluates this with its npm-semver fallback.)
      description: "Sonarr stays on v4",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/sonarr"],
      allowedVersions: "<5",
    },
    {
      // 3.x is young and moves fast; review every Tdarr update by hand.
      description: "Tdarr is never automerged",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/haveagitgat/tdarr"],
      automerge: false,
    },
    {
      // 1.0.0 shipped with config bugs (Unpackerr/unpackerr#831). Skip it and
      // review every 1.x update by hand.
      description: "Unpackerr skips 1.0.0 and is never automerged",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/unpackerr/unpackerr"],
      allowedVersions: "!/^v?1\\.0\\.0$/",
      automerge: false,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
