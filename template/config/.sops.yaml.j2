---
creation_rules:
  # sops uses the first matching rule; keep the archive rule ahead of the
  # bootstrap/kubernetes one, which would otherwise match archive/k3s/kubernetes/.
  - path_regex: ^archive/k3s/.*\.sops\.ya?ml$
    encrypted_regex: "^(data|stringData)$"
    age: "#{ age_key('public') }#"
  - path_regex: ^talos/.*\.sops\.ya?ml$
    mac_only_encrypted: true
    age: "#{ age_key('public') }#"
  - path_regex: ^(bootstrap|kubernetes)/.*\.sops\.ya?ml$
    encrypted_regex: "^(data|stringData)$"
    mac_only_encrypted: true
    age: "#{ age_key('public') }#"
  # Not rendered by the template: Terraform credentials.
  - path_regex: ^terraform/.*\.sops\.(ya?ml|json|env)$
    age: "#{ age_key('public') }#"
stores:
  yaml:
    indent: 2
