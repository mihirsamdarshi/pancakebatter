---
# TrueNAS monitoring: the two scrape jobs, the alert rules and the recording
# rules. It has its own Kustomization so it can be removed alone; the
# truenas-monitoring app on TrueNAS (192.168.10.75:9100 and :9633) is created
# separately and does not depend on this.
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: truenas
spec:
  dependsOn:
    # The ScrapeConfig and PrometheusRule CRDs come from kube-prometheus-stack.
    - name: kube-prometheus-stack
  interval: 1h
  path: ./kubernetes/apps/observability/truenas/app
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: observability
  wait: false
