{
  "title": "Cilium",
  "uid": "cilium",
  "description": "Cilium agents and operator, using the metrics this cluster keeps (endpoints, drops, forwarding, BPF map pressure, conntrack, LB IPAM).",
  "editable": false,
  "schemaVersion": 41,
  "tags": [
    "cilium",
    "network"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timepicker": {},
  "graphTooltip": 1,
  "links": [
    {
      "title": "Homelab overview",
      "type": "link",
      "url": "/d/homelab-overview",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
