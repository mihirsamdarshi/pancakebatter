---
# Pod Security is not set here: the flux-operator renders this Namespace with
# kustomize.toolkit.fluxcd.io/ssa: Ignore, so Flux never applies this file's
# labels. The enforce level lives in flux-instance/app/helmrelease.yaml as a
# FluxInstance kustomize patch; the operator already sets warn: restricted.
apiVersion: v1
kind: Namespace
metadata:
  name: flux-system
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
