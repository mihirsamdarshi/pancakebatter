#% if repository.webhook_provider != 'none' %#
---
apiVersion: v1
kind: Secret
metadata:
  name: flux-webhook-token
  labels:
    # Lets the Receiver pick up a rotated token without waiting for its interval.
    reconcile.fluxcd.io/watch: Enabled
stringData:
  token: "#{ webhook_token() }#"
#% endif %#
