---
apiVersion: v1
kind: Namespace
metadata:
  name: network
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
  labels:
    # Pod Security. The Talos config drops the cluster-wide default, so only
    # these labels apply. baseline is enforced: a server-side dry run on
    # October 27, 2026 found every pod within it, and only k8s-gateway outside
    # restricted (allowPrivilegeEscalation, capabilities, runAsNonRoot,
    # seccompProfile). warn/audit stay at restricted so that gap stays visible;
    # move enforce up once k8s-gateway's securityContext is set.
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
