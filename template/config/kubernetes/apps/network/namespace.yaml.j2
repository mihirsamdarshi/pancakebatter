---
apiVersion: v1
kind: Namespace
metadata:
  name: network
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
  labels:
    # Pod Security. The Talos config drops the cluster-wide default, so only
    # these labels apply. restricted since October 28, 2026: k8s-gateway was
    # the last pod outside it (fixed in its HelmRelease), and a server-side dry
    # run found no violation. The Envoy Gateway controller and proxies were
    # already within it.
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
