---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: local-path-provisioner
spec:
  chart:
    spec:
      chart: ./deploy/chart/local-path-provisioner
      sourceRef:
        kind: GitRepository
        name: local-path-provisioner
  interval: 1h
  values:
    helperImage:
      repository: docker.io/library/busybox
      tag: 1.37.0
    storageClass:
      # Node-local, not replicated: for data that can be lost with a node
      # (metrics, logs). Not the default class, so each PVC opts in; Rook
      # becomes the default when calvin and susie return.
      defaultClass: false
      name: local-path
      reclaimPolicy: Delete
      volumeBindingMode: WaitForFirstConsumer
    # Talos user volume on the dedicated scsi1 disk (talos/all/72-local-path.yaml).
    nodePathMap:
      - node: DEFAULT_PATH_FOR_NON_LISTED_NODES
        paths:
          - /var/mnt/local-path
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
