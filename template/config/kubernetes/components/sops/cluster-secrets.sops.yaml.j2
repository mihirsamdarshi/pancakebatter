---
apiVersion: v1
kind: Secret
metadata:
  name: cluster-secrets
stringData:
  # The zone itself. domain.name is the LAN name below it (local.<zone>).
  SECRET_DOMAIN: "#{ domain.name.removeprefix('local.') }#"
  # LAN hostnames: envoy-internal, k8s-gateway split DNS, the wildcard certificate.
  SECRET_DOMAIN_LOCAL: "#{ domain.name }#"
  # Family apps live under family.<zone>, one label above the local. apps.
  SECRET_FAMILY_DOMAIN: "family.#{ domain.name.removeprefix('local.') }#"
