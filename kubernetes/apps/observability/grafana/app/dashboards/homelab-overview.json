    {
      "type": "table",
      "title": "Flux not Ready",
      "description": "Empty is good. Flux objects that are not Ready.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
