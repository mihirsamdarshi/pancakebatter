          "expr": "((kube_pod_status_phase{phase=~\"Pending|Running\"} == 1) * on (namespace, pod, uid) group_left () (1 - kube_pod_status_ready{condition=\"true\"}) == 1)",
          "format": "table",
          "instant": true
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
