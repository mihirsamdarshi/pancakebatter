{
  "title": "Storage and backups",
  "uid": "storage-backups",
  "description": "PVC usage and growth, node disks, and VolSync backup health.",
  "editable": false,
  "schemaVersion": 41,
  "tags": [
    "storage",
    "volsync",
    "backups"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timepicker": {},
  "graphTooltip": 1,
  "links": [
    {
      "title": "Homelab overview",
      "type": "link",
      "url": "/d/homelab-overview",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Backups (VolSync)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Sources out of sync",
      "description": "VolSync sources whose last sync is overdue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(volsync_volume_out_of_sync == 1) or (count(volsync_volume_out_of_sync) * 0)",
          "instant": true
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Missed intervals (7 d)",
      "description": "Scheduled syncs that did not start in time, over the last 7 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(volsync_missed_intervals_total[7d]))",
          "instant": true
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Syncs (24 h)",
      "description": "Completed syncs in the last day, all sources.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(volsync_sync_duration_seconds_count[24h]))",
          "instant": true
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Slowest sync",
      "description": "Longest median sync time of any source.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(volsync_sync_duration_seconds{quantile=\"0.5\"})",
          "instant": true
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Backup status",
      "description": "One restic source per app.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "in sync",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "OUT OF SYNC",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "App",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "endpoint": true,
              "service": true,
              "instance": true,
              "container": true,
              "namespace": true,
              "method": true,
              "role": true,
              "pod": true
            },
            "renameByName": {
              "obj_name": "App",
              "obj_namespace": "Namespace",
              "Value": "Status"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "volsync_volume_out_of_sync",
          "format": "table",
          "instant": true
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Sync duration",
      "description": "Median and 99th percentile of recent sync times, per source.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "volsync_sync_duration_seconds{quantile=\"0.5\"}",
          "legendFormat": "{{obj_name}} p50"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Syncs per day",
      "description": "Syncs completed in the trailing 24 hours. A source that drops to zero has stopped backing up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (obj_name) (increase(volsync_sync_duration_seconds_count[24h]))",
          "legendFormat": "{{obj_name}}"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 9
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Persistent volumes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "NFS dataset usage",
      "description": "Used share of the shared NFS dataset behind the media and downloads PVCs. All six static NFS PVCs report the same figure, so it is shown once. Local-path and local-retain volumes export no per-PVC usage, so they are not covered here; see the node disk panels.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes)",
          "legendFormat": "NFS dataset",
          "instant": true
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "table",
      "title": "Days until node disk full",
      "description": "Linear projection from the last 7 days of change in free space on the node disks (/var and the local-path disk). Only disks projected to fill within a year appear; empty is good. Per-PVC projections are not possible: local volumes have no usage series.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Days left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "green",
                      "value": 30
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Days left",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "endpoint": true,
              "service": true,
              "instance": true,
              "container": true,
              "device": true,
              "fstype": true,
              "namespace": true,
              "pod": true
            },
            "renameByName": {
              "nodename": "Node",
              "mountpoint": "Mount",
              "Value": "Days left"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_filesystem_avail_bytes{mountpoint=~\"/var|/var/mnt/local-path\"} / (-deriv(node_filesystem_avail_bytes{mountpoint=~\"/var|/var/mnt/local-path\"}[7d]) > 0) / 86400 * on (instance) group_left (nodename) node_uname_info < 365",
          "format": "table",
          "instant": true
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 17
      }
    },
    {
      "type": "stat",
      "title": "PVCs not Bound",
      "description": "Claims that are Pending or Lost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
