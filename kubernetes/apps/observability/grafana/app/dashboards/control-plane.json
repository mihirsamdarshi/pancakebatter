    {
      "type": "timeseries",
      "title": "Mean latency (GET and LIST only)",
      "description": "Mean time to answer a request (sum / count). Only GET and LIST have a duration count in the kept metrics; writes (POST, PUT, PATCH, DELETE) are missing, and WATCH and CONNECT stay open and are excluded. The histogram buckets are not kept.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
